# Arch Linux package for Vernier. From this directory:
#   makepkg -si
# Builds the v0.1.0 release tarball, checked against sha256sums.
# Maintainer: Mohamed Hammad <Mohamed.Hammad@SpacecraftSoftware.org>

pkgname=vernier
pkgver=0.1.0
pkgrel=1
pkgdesc='Arrange, rotate, scale and mirror displays on Wayland and X11'
arch=('x86_64' 'aarch64')
url='https://Vernier.SpacecraftSoftware.org/'
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc')
optdepends=(
  'wayland: the editor on Wayland sessions'
  'libxkbcommon: keyboard input in the editor'
  'vulkan-icd-loader: GPU rendering in the editor'
  'libglvnd: OpenGL rendering in the editor'
)
makedepends=('cargo' 'texinfo')
install=vernier.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/Spacecraft-Software/Vernier/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('d3713e070b057f8da1347b894756ce24fb76a11c135d81746496646f6fe78892')

prepare() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release -p vnr
  makeinfo --no-split -o "$srcdir/vernier.info" doc/vernier.texi
}

check() {
  cd "$srcdir/$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --workspace
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 "$srcdir/target/release/vnr" "$pkgdir/usr/bin/vnr"
  install -Dm644 "$srcdir/vernier.info" "$pkgdir/usr/share/info/vernier.info"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
