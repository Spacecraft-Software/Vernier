(define vernier
  (package
    (name "vernier")
    (version "0.1.0")
    (source (local-file %source-root "vernier-checkout"
                        #:recursive? #t
                        #:select? (git-predicate %source-root)))
    (build-system cargo-build-system)
    (arguments
     (list
      #:install-source? #f
      #:cargo-install-paths '(list "crates/vnr")
      #:phases
      #~(modify-phases %standard-phases
          (add-after 'install 'install-manual
            ;; The Info manual (Steelbore Standard section 8). Guix
            ;; registers every share/info file in the profile's Info
            ;; directory when the package is installed.
            (lambda _
              (let ((info (string-append #$output "/share/info")))
                (mkdir-p info)
                (invoke "makeinfo" "--no-split"
                        "-o" (string-append info "/vernier.info")
                        "doc/vernier.texi"))))
          (add-after 'install-manual 'wrap-libraries
            ;; The binary links only the C runtime; the editor opens
            ;; these with dlopen, so they go on LD_LIBRARY_PATH.
            (lambda* (#:key inputs #:allow-other-keys)
              (wrap-program (string-append #$output "/bin/vnr")
                `("LD_LIBRARY_PATH" ":" prefix
                  ,(map (lambda (name)
                          (string-append (assoc-ref inputs name) "/lib"))
                        '("wayland" "libxkbcommon" "vulkan-loader"
                          "mesa")))))))))
    (native-inputs (list texinfo))
    (inputs (cons* libxkbcommon mesa vulkan-loader wayland
                   vernier-cargo-inputs))
    (home-page "https://Vernier.SpacecraftSoftware.org/")
    (synopsis "Arrange, rotate, scale and mirror displays on Wayland and X11")
    (description
     "Vernier (@command{vnr}) configures displays on wlroots compositors,
COSMIC, KDE Plasma, GNOME and X11, with a graphical editor and a scriptable
command line.  Every interactive change is reverted unless confirmed.")
    (license license:gpl3+)))


