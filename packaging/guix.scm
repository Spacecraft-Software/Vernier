;;; Until the first release is tagged this builds the git checkout it sits
;;; in; the release switches `source' to the tag's tarball and its hash.
;;; The crate list below is generated from Cargo.lock by
;;; scripts/guix-crates.py; regenerate it whenever Cargo.lock changes.

(use-modules (guix packages)
             (guix gexp)
             (guix utils)
             (guix git-download)
             (guix build-system cargo)
             ((guix licenses) #:prefix license:)
             (gnu packages freedesktop)
             (gnu packages gl)
             (gnu packages texinfo)
             (gnu packages vulkan)
             (gnu packages xdisorg))

(define %source-root
  (dirname (current-source-directory)))

